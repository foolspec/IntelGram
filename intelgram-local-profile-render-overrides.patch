+		return QString::number(getBareID(clone));
+	}
+	if (!LocalProfileIdActive(peer)) {
+		return QString::number(getBareID(peer));
+	}
+	return NormalizeLocalProfileId(
+		AyuSettings::getInstance().localProfileId());
+}
